rustc-ice-*.txt

# Never commit real save files -- deliberately unanchored so a copied save
# is ignored anywhere in the tree. (Tests read saves from paths outside the
# repo via ICARUS_CHARACTERS / ICARUS_PROFILE env vars.)
Characters.json
Profile.json
